# Local development only. Never commit real secrets.
BLITZ_FUT_DEBUG=true
BLITZ_FUT_SECRET_KEY=replace-with-a-random-local-secret
BLITZ_FUT_ALLOWED_HOSTS=localhost,127.0.0.1
BLITZ_FUT_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BLITZ_FUT_DB_PATH=/absolute/path/to/blitz_fut/backend/db.sqlite3
BLITZ_FUT_BACKUP_DIR=/absolute/path/to/blitz_fut/backend/backups
